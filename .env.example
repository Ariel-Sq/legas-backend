# Application configuration
PORT=3001

# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ecommerce_db

# Rate limiting configuration
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# Auth — Google id_token verification + backend-issued JWT
# Must match the Google OAuth client the frontend uses (id_token `aud`).
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Strong random secret used to sign the backend session JWT (HS256).
JWT_SECRET=change-me-to-a-long-random-string
# Backend JWT lifetime (jsonwebtoken expiresIn syntax).
JWT_EXPIRES_IN=7d
# Set to "production" in prod (controls secure-cookie flag and disables the
# development data-reset endpoint).
NODE_ENV=development

# CORS allowlist (comma-separated). Default: localhost dev origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# TypeORM SQL logging — set to 1 to dump all queries (very noisy).
LOG_SQL=0

# Storage Configuration. SUPABASE or LOCAL
STORAGE_TYPE=LOCAL
# Local storage Configuration
PATH=~/.storage
# Supabase Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=images

MERCADO_PAGO_ACCESS_TOKEN=your_access_token_here
MERCADO_PAGO_SUCCESS_URL=https://example.com/checkout/success
MERCADO_PAGO_FAILURE_URL=https://example.com/checkout/failure
MERCADO_PAGO_PENDING_URL=https://example.com/checkout/pending
MERCADOPAGO_WEBHOOK_SECRET=your_webhook_secret
MERCADO_PAGO_WEBHOOK_URL=https://example.com/api/webhooks/mercadopago
